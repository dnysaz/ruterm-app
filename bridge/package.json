{
  "name": "rterm-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "RuTerm sync bridge \u2014 Cloudflare Worker + D1. Serverless vault sync; the desktop app stays fully functional offline without it.",
  "scripts": {
    "dev": "wrangler dev --local",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply rterm-sync --local",
    "db:migrate:remote": "wrangler d1 migrations apply rterm-sync --remote",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "jose": "^6.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261118.1",
    "typescript": "^5.6.0",
    "wrangler": "^4.0.0"
  }
}