{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RuTerm",
  "version": "0.1.0",
  "identifier": "app.rterm",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "RuTerm",
        "width": 1180,
        "height": 760,
        "minWidth": 920,
        "minHeight": 600,
        "backgroundColor": "#0b0b0c",
        "theme": "Dark",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Open-source SSH workspace with zero-knowledge sync",
    "longDescription": "RuTerm is an open-source SSH client that keeps hosts, keys and settings in a single readable JSON vault, seals secrets locally, and syncs through your own zero-knowledge Cloudflare Worker + D1 bridge \u2014 or stays fully local."
  }
}
